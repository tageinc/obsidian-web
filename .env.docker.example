APP_NAME=Obsidian
APP_KEY=
APP_URL=http://localhost:8080
APP_BIND=127.0.0.1
APP_PORT=8080
DB_DATABASE=obsidian
DB_USERNAME=obsidian
DB_PASSWORD=
DB_ROOT_PASSWORD=
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
LOG_LEVEL=warning
MAIL_MAILER=log
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME=Obsidian
MAIL_PER_MINUTE=30
DEVELOPER_EMAIL=andre.troncoso@tezca.net
PAGINATION_SIZE=10

# Use the reviewed Vue frontend. Per-page FRONTEND_VUE3_* overrides take precedence.
FRONTEND_VUE3_ENABLED=true
FRONTEND_VUE3_WORKSPACE=true

# Optional disposable server caches/counters; sessions and queues stay unchanged.
# Start the local service explicitly with --profile redis.
REDIS_WORKLOADS_ENABLED=false
REDIS_WORKLOADS_VERSIONS_ENABLED=true
REDIS_WORKLOADS_METRICS_ENABLED=true
REDIS_WORKLOADS_HOST=redis
REDIS_WORKLOADS_PORT=6379
REDIS_WORKLOADS_DB=2
REDIS_WORKLOADS_PASSWORD=

# Used by DeveloperSeeder to create the configured developer once.
DEVELOPER_BOOTSTRAP_PASSWORD=
DEVELOPER_BOOTSTRAP_NAME="Obsidian Developer"
