# Copy this file to .env for local XAMPP development.
# Never commit .env or put production credentials in this file.

APP_NAME=Obsidian
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# XAMPP MariaDB defaults. Create the database before migrating:
# mysql -u root -e "CREATE DATABASE obsidian_local"
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=obsidian_local
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
LOG_CHANNEL=stack
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_FROM_ADDRESS=local@localhost
MAIL_FROM_NAME="Obsidian Local"

# This email receives the local admin navigation entry.
ADMIN_EMAIL=andre.troncoso@tezca.net
# Required only when running UserSeeder locally; keep the value in .env.
LOCAL_ADMIN_PASSWORD=

PAGINATION_SIZE=10
